# SnapStudy Frontend Environment Variables
# Copy this file to .env.local for local development

# =============================================================================
# API Configuration
# =============================================================================

# Backend API URL - Update this to match your backend
REACT_APP_API_URL=http://localhost:8000

# For AWS API Gateway, use format:
# REACT_APP_API_URL=https://abc123def.execute-api.us-east-1.amazonaws.com/prod

# For custom domain:
# REACT_APP_API_URL=https://api.snapstudy.com

# =============================================================================
# AWS Configuration (Optional - for Cognito authentication)
# =============================================================================

REACT_APP_AWS_REGION=us-east-1
# REACT_APP_USER_POOL_ID=us-east-1_ABC123DEF
# REACT_APP_USER_POOL_CLIENT_ID=1a2b3c4d5e6f7g8h9i0j

# =============================================================================
# Application Settings
# =============================================================================

# Application Name
REACT_APP_APP_NAME=SnapStudy

# Enable/disable development features
REACT_APP_DEBUG=true

# =============================================================================
# Feature Flags (Optional)
# =============================================================================

# REACT_APP_ENABLE_ANALYTICS=true
# REACT_APP_ENABLE_ERROR_REPORTING=true
# REACT_APP_ENABLE_PERFORMANCE_MONITORING=true